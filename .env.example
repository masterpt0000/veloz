# Copy to .env next to docker-compose.yml and adjust as needed.

POSTGRES_USER=veloz
POSTGRES_PASSWORD=veloz
POSTGRES_DB=veloz_candles
TIMESCALE_PORT=5432

CANDLES_API_PORT=8080
# Optional: require X-API-Key header on /candles (empty = open LAN)
CANDLES_API_KEY=
CORS_ORIGINS=*

# Binance ingest
BINANCE_MARKET=spot
# Optional override (default spot: https://data-api.binance.vision/api/v3/klines)
# BINANCE_REST_URL=
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
INGEST_BACKFILL_DAYS=7
INGEST_POLL_SECONDS=30
RUN_INGEST=1

# Frontend (Vite) — point Veloz at the API on m4st3r / localhost
# VITE_CANDLES_API_URL=http://192.168.1.216:8080
# VITE_CANDLES_API_KEY=
