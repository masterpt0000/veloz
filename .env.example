# Copy to .env next to docker-compose.yml.
# Open-LAN defaults: empty API key + CORS * + Postgres on 0.0.0.0.
# Generate a strong DB password (do not commit .env):
#   openssl rand -hex 24   # → POSTGRES_PASSWORD
# Optional lock-down (not the LAN default):
#   openssl rand -hex 32   # → CANDLES_API_KEY (≥16 chars)

POSTGRES_USER=veloz
POSTGRES_PASSWORD=
POSTGRES_DB=veloz_candles
TIMESCALE_PORT=5432

CANDLES_API_PORT=8080
# Leave empty for open LAN (no X-API-Key). If set (≥16 chars), clients must send X-API-Key.
CANDLES_API_KEY=
# "*" = any origin (LAN open). Or a comma-separated allowlist to lock down.
CORS_ORIGINS=*

# Backfill bounds
MAX_BACKFILL_SYMBOLS=10
MAX_BACKFILL_DAYS=366

# Binance ingest
BINANCE_MARKET=spot
# Optional override (default spot: https://data-api.binance.vision/api/v3/klines)
# BINANCE_REST_URL=
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
INGEST_BACKFILL_DAYS=7
INGEST_POLL_SECONDS=30
# Continuous poller on API startup. Daily gap-fill is separate: python -m app.daily_sync (cron).
RUN_INGEST=1

# Frontend (Vite) — URL only. Do NOT set a VITE_* API key (it would ship in the browser bundle).
# Optional key (when server auth is on): paste in Dados BD → sessionStorage.
# VITE_CANDLES_API_URL=http://192.168.1.216:8080
