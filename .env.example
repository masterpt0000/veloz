# Copy to .env next to docker-compose.yml and fill REQUIRED secrets.
# Generate strong values (do not commit .env):
#   openssl rand -hex 24   # → POSTGRES_PASSWORD
#   openssl rand -hex 32   # → CANDLES_API_KEY

POSTGRES_USER=veloz
POSTGRES_PASSWORD=
POSTGRES_DB=veloz_candles
TIMESCALE_PORT=5432

CANDLES_API_PORT=8080
# Required (min 16 chars). Sent by clients as X-API-Key — never bake into public Vite builds.
CANDLES_API_KEY=
# Explicit allowlist only (no *). Comma-separated.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173,https://veloz.apps.grok.bot

# Backfill bounds
MAX_BACKFILL_SYMBOLS=10
MAX_BACKFILL_DAYS=366

# Binance ingest
BINANCE_MARKET=spot
# Optional override (default spot: https://data-api.binance.vision/api/v3/klines)
# BINANCE_REST_URL=
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
INGEST_BACKFILL_DAYS=7
INGEST_POLL_SECONDS=30
# Continuous poller on API startup. Daily gap-fill is separate: python -m app.daily_sync (cron).
RUN_INGEST=1

# Frontend (Vite) — URL only. Do NOT set a VITE_* API key (it would ship in the browser bundle).
# Enter the API key in the Dados BD panel (sessionStorage) or use a local reverse proxy that injects X-API-Key.
# VITE_CANDLES_API_URL=http://192.168.1.216:8080
